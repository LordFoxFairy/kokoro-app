# Next.js standard production filename. Do not commit a real copy.
# Prefer Docker/Cloudflare runtime variables instead of baking secrets into a build.
KOKORO_DOMAIN="app.example.com"
KOKORO_WEB_ORIGIN="https://app.example.com"
KOKORO_WEB_REDIS_URL="redis://redis:6379/0"
KOKORO_WEB_SESSION_SECRET="CHANGE_ME"
# Business APIs and Chat use the independent BFF; auth remains explicit.
KOKORO_BFF_BASE_URL="http://kokoro-bff:4300"
# Required for Web BFF → upstream service authentication. Forwarded is routing context only.
KOKORO_INTERNAL_SECRET_WEB_BFF="CHANGE_ME_INTERNAL_SECRET"
# Auth remains explicit; there is no Gateway fallback.
KOKORO_IAM_BASE_URL="http://kokoro-iam:4211"
# Skills、MCP、Agent connection setup、支付等业务 API 统一经由 BFF，
# 不填写业务仓库的直连地址。
# KOKORO_PAYMENT_MOCK_WEBHOOK_SECRET is intentionally not supported in production.

# W1C-2C RP-only OIDC (server-side; Product Session is not installed yet).
# NEXTAUTH_URL="http://HOST:PORT/api/auth"  # exactly KOKORO_WEB_ORIGIN + /api/auth
# KOKORO_OIDC_CLIENT_ID="WEB_RP_CLIENT_ID"
# KOKORO_OIDC_CLIENT_SECRET="CHANGE_ME_RP_CLIENT_SECRET"
# KOKORO_WEB_AUTH_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"
