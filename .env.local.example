# Next.js local desktop preview. Copy to `.env.local` for `pnpm dev`.
# `*.localhost` resolves to loopback; open http://dev.kokoro.localhost:3000.
KOKORO_DOMAIN="dev.kokoro.localhost"
KOKORO_WEB_ORIGIN="http://dev.kokoro.localhost:3000"
# Live IAM sign-in needs the shared Redis instance for one-time CSRF proof.
# KOKORO_WEB_REDIS_URL="redis://127.0.0.1:6379/0"
NEXT_PUBLIC_SESSION_PREVIEW="1"

# To exercise the local BFF mock, remove preview mode and fill every required
# server-only value. Never prefix these with NEXT_PUBLIC_.
# Business APIs and Chat go through the independent kokoro-bff Chat module.
# KOKORO_BFF_BASE_URL="http://127.0.0.1:4300"
# KOKORO_INTERNAL_SECRET_WEB_BFF="local-web-bff-secret"
# KOKORO_TENANT_ID="FIXED_DEPLOYMENT_TENANT_ID"
# Skills、MCP、Agent connection setup、支付等业务 API 统一走 BFF。

# Product OIDC RP and online Product Session admission (server-side only).
# NEXTAUTH_URL="http://HOST:PORT/api/auth"  # exactly KOKORO_WEB_ORIGIN + /api/auth
# KOKORO_OIDC_CLIENT_ID="WEB_RP_CLIENT_ID"
# KOKORO_OIDC_CLIENT_SECRET="CHANGE_ME_RP_CLIENT_SECRET"
# KOKORO_WEB_AUTH_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"
