# Next.js local desktop preview. Copy to `.env.local` for `pnpm dev`.
# `*.localhost` resolves to loopback; open http://dev.kokoro.localhost:3000.
KOKORO_DOMAIN="dev.kokoro.localhost"
NEXT_PUBLIC_SESSION_PREVIEW="1"

# To exercise the local BFF mock, remove preview mode and fill every required
# server-only value. Never prefix these with NEXT_PUBLIC_.
# KOKORO_WEB_SESSION_SECRET="local-only-secret"
# Business APIs go through the independent kokoro-bff; Chat remains Session.
# KOKORO_BFF_BASE_URL="http://127.0.0.1:4300"
# KOKORO_INTERNAL_SECRET_WEB_BFF="local-web-bff-secret"
# KOKORO_USER_BASE_URL="http://127.0.0.1:4211"
# KOKORO_SESSION_BASE_URL="http://127.0.0.1:3900"
# KOKORO_SYSTEM_BASE_URL="http://127.0.0.1:4240"
# KOKORO_HUB_BASE_URL="http://127.0.0.1:4251"
# KOKORO_AGENT_BASE_URL="http://127.0.0.1:4260"
# KOKORO_PAYMENT_BASE_URL="http://127.0.0.1:4241"
# KOKORO_BILLING_BASE_URL="http://127.0.0.1:4245"
