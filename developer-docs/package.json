{
  "name": "@kokoro/developer-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm reference:generate && vitepress dev docs",
    "build": "pnpm reference:generate && vitepress build docs",
    "preview": "vitepress preview docs",
    "lint": "eslint . && markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "provenance:check": "node scripts/verify-provenance.mjs",
    "reference:generate": "node scripts/generate-reference.mjs",
    "reference:check": "node scripts/check-reference.mjs",
    "examples:check": "node scripts/check-examples.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "links:check": "node scripts/check-links.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm provenance:check && pnpm reference:check && pnpm examples:check && pnpm architecture:check && pnpm build && pnpm links:check",
    "ci": "pnpm check"
  },
  "dependencies": {
    "vitepress": "1.6.4",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
