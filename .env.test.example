# Deterministic test fixture environment. Copy to `.env.test` only when a
# runner needs environment-file loading; Vitest tests also set isolated values.
KOKORO_DOMAIN="test.kokoro.localhost"
NEXT_PUBLIC_SESSION_PREVIEW="1"
# Set these when running the test Web BFF against independent local services.
# KOKORO_BFF_BASE_URL="http://127.0.0.1:4301"
# KOKORO_INTERNAL_SECRET_WEB_BFF="test-web-bff-secret"
# KOKORO_IAM_BASE_URL="http://127.0.0.1:4211"
# Chat 及其他业务 API 统一经由 BFF；测试夹具不配置业务仓库直连地址。
