# Deterministic test fixture environment. Copy to `.env.test` only when a
# runner needs environment-file loading; Vitest tests also set isolated values.
KOKORO_DOMAIN="test.kokoro.localhost"
KOKORO_WEB_ORIGIN="http://test.kokoro.localhost:3000"
# Test runner uses unique Web-origin-derived CSRF prefix and cleans only its own keys.
# KOKORO_WEB_REDIS_URL="redis://127.0.0.1:6379/0"
NEXT_PUBLIC_SESSION_PREVIEW="1"
# Set these when running the test Web BFF against independent local services.
# KOKORO_BFF_BASE_URL="http://127.0.0.1:4301"
# KOKORO_INTERNAL_SECRET_WEB_BFF="test-web-bff-secret"
# KOKORO_IAM_BASE_URL="http://127.0.0.1:4211"
# Chat 及其他业务 API 统一经由 BFF；测试夹具不配置业务仓库直连地址。

# W1C-2C RP-only OIDC (server-side; Product Session is not installed yet).
# NEXTAUTH_URL="http://HOST:PORT/api/auth"  # exactly KOKORO_WEB_ORIGIN + /api/auth
# KOKORO_OIDC_CLIENT_ID="WEB_RP_CLIENT_ID"
# KOKORO_OIDC_CLIENT_SECRET="CHANGE_ME_RP_CLIENT_SECRET"
# KOKORO_WEB_AUTH_SECRET="CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG"
