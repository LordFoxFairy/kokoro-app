{
  "name": "@kokoro/app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "contract": "vitest run contract tests/contract",
    "test:architecture": "vitest run tests/architecture",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "smoke:first-site": "node scripts/first-site-smoke.mjs",
    "check": "pnpm contract && pnpm test:architecture && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@ai-sdk/react": "4.0.95",
    "@bufbuild/protobuf": "2.14.0",
    "@kokoro/i18n": "workspace:*",
    "@kokoro/web-core": "workspace:*",
    "@shadcn/react": "^0.3.0",
    "ai": "7.0.92",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.2.6",
    "next-auth": "4.24.15",
    "openid-client": "5.7.1",
    "qrcode.react": "4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "redis": "5.12.1",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@kokoro/tsconfig": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.1.3",
    "vitest": "4.1.10",
    "wrangler": "^4.127.1"
  }
}
