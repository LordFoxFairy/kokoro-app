# kokoro Web Compose/生产变量总模板（全部为明显假值，勿用于生产）。
# Next.js 本地开发请复制 .env.local.example → .env.local；测试请使用 .env.test.example。
# .env.prod 仅是 Docker/运维文件名，Next.js 不会自动加载它；Next 标准生产文件名是 .env.production。
# 一个独立 Web 仓库对应一个产品部署；运行时不选择 Site/tenant，也不需要多站 registry。
# KOKORO_DOMAIN 是当前部署的规范域名，BFF 会把它编码为 RFC 7239 `Forwarded` 注入每一个上游请求。
KOKORO_DOMAIN="dev.kokoro.localhost"

# Preferred live topology: Web business routes use one independent server-only BFF.
# Chat/auth keep explicit service URLs and are not routed through the business BFF.
# KOKORO_BFF_BASE_URL="http://kokoro-bff:4300"

# httpOnly 会话信封的服务端封缄密钥。逗号分隔支持密钥轮换：新密钥放队首，旧密钥保留一个窗口后删除。
KOKORO_WEB_SESSION_SECRET="example-session-secret-not-real"

# BFF 上游基址。浏览器只访问同源 /api/*，以下地址只在服务端使用。
# 业务面由 kokoro-bff 负责；下面的单服务地址仅用于分阶段迁移覆盖。
# 每次出站请求都由 BFF 统一生成：Forwarded: host=${KOKORO_DOMAIN}
# user：magic-link、auth callback、team switch 等身份相关操作。
# KOKORO_USER_BASE_URL="http://kokoro-user:4211"
# session：对话流 SSE、会话清单、计费窄读、成果、分享。
# KOKORO_SESSION_BASE_URL="http://kokoro-session:3900"
# system：菜单、i18n、主题、产品入口和 feature manifest。
# KOKORO_SYSTEM_BASE_URL="http://kokoro-system:4240"
# 服务端 workload token；绝不使用 NEXT_PUBLIC_*。
# KOKORO_SYSTEM_WORKLOAD_TOKEN="example-workload-token"

# 能力中台 hub（Skills/MCP/凭据）；缺省时相关页面显示不可用态。可选。
# KOKORO_HUB_BASE_URL="http://kokoro-hub:4251"
# Agent 外部连接 setup 能力；缺省时 Agent 页面保留 preview/不可用态。可选。
# KOKORO_AGENT_BASE_URL="http://kokoro-agent:4260"
# 支付 storefront；缺省时价格面板显示“暂未开通”。可选。
# KOKORO_PAYMENT_BASE_URL="http://kokoro-payment:4241"
# KOKORO_BILLING_BASE_URL="http://kokoro-billing:4245"

# Web BFF 出站内部服务凭据（TRUST-ROUTES）。配置业务 BFF 或生产直连上游时必填。
# 纯 preview（不配置业务上游）可省略。Forwarded 只是路由上下文，不能替代服务认证。
# KOKORO_INTERNAL_SECRET_WEB_BFF="CHANGE_ME_INTERNAL_SECRET"

# 本地确定性预览，不连接真实后端；生产环境必须关闭。
# NEXT_PUBLIC_SESSION_PREVIEW="1"

# production 时启用 secure cookie 并关闭开发链接回显；通常由运行时注入。
# NODE_ENV="development"
